# Loaded automatically by app.py and manage.py. Existing exported values take precedence.
CHURCH_NAME="Love Assembly"
PORTAL_URL="http://localhost:5173"

# Fill in your provider's SMTP settings to enable welcome emails.
# Keep SMTP_HOST empty until you are ready to enable delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=""
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Optional overrides:
# CHURCH_DATA_DIR=data
# ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
# Comma-separated reverse proxy addresses allowed to set X-Forwarded-For.
# TRUSTED_PROXIES=127.0.0.1
# Breached-password lookups (k-anonymity) against api.pwnedpasswords.com: on or off.
# PASSWORD_BREACH_CHECK=on
